# Copy to .env and adjust. Never commit .env.

# Migrations run as the table owner.
DATABASE_URL=postgres://livemap_migrator:livemap_dev@127.0.0.1:5460/livemap

# The application connects as a non-owner role so row-level security actually
# applies to it. A table owner bypasses RLS unless FORCE is set, and relying on
# FORCE alone is one `alter table` away from a silent tenant leak.
APP_DATABASE_URL=postgres://livemap_app:livemap_dev_app@127.0.0.1:5460/livemap

# Cross-tenant platform work only — provisioning a tenant, a support query, a
# backfill. This role has BYPASSRLS, so every policy is inert on it. It is NOT
# the schema owner, which is what separates "may read any tenant" from "may run
# DDL". Never point APP_DATABASE_URL here; serve.mjs asserts that at boot.
ADMIN_DATABASE_URL=postgres://livemap_admin:livemap_dev_admin@127.0.0.1:5460/livemap

POSTGRES_PASSWORD=livemap_dev
APP_DB_PASSWORD=livemap_dev_app
ADMIN_DB_PASSWORD=livemap_dev_admin

# HMAC key for session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me

PORT=8787
LOG_LEVEL=info

# Addresses or CIDRs of the proxies in front of the server, comma-separated.
# Leave unset when it is reached directly. Behind a proxy it must be set:
# otherwise every visitor appears to come from the proxy and each per-address
# rate limit becomes one bucket shared by everyone.
# TRUST_PROXY=127.0.0.1

# --- Published artifacts ----------------------------------------------------

# Cloudflare R2, through its S3 API. Set all four or none. With none, published
# maps are held in the server's memory and lost on restart, which the server
# refuses to do when NODE_ENV=production.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Where readers fetch artifacts from: the bucket's public custom domain, no
# trailing slash. Required with R2. The bucket needs a CORS rule allowing GET
# from any origin with the request headers `cache-control` and `if-none-match`
# and exposing `etag` — the embedded viewer sends both and reads the third.
# PUBLIC_ARTIFACT_BASE=https://maps.example.com

# --- Guest workspaces -------------------------------------------------------

# "on" registers POST /auth/guest and makes ADMIN_DATABASE_URL required.
# Anything else and the route does not exist.
GUEST_SIGNUP=off

# Cloudflare Turnstile keys, from one widget. With it set, signup is refused without a
# token the widget issued. In production the server will not start with guest
# signup on and this unset, unless GUEST_SIGNUP_UNCHECKED=on says that is meant.
# TURNSTILE_SITE_KEY is the public half, handed to the sign-in page. Set both
# or neither.
# TURNSTILE_SECRET=
# TURNSTILE_SITE_KEY=
# GUEST_SIGNUP_UNCHECKED=off

# Signup answers 503 once this many guest tenants exist, expired ones included.
# Expired guests are removed by `npm run reap-guests`, which MUST be scheduled
# — nothing in the server runs it.
MAX_GUESTS=500

# What one guest workspace may hold.
GUEST_MAX_MAPS=5
GUEST_MAX_FEATURES_PER_MAP=2000
GUEST_MAX_VERSIONS_PER_MAP=25
GUEST_MAX_BODY_BYTES=524288

# --- Rate limits ------------------------------------------------------------
# RATE_<TIER>_MAX requests per RATE_<TIER>_WINDOW, counted per route.
#   signup   per address        publish  per user (and rollback)
#   write    per user           read     per user
#   unauth   rejected credentials, per address
RATE_SIGNUP_MAX=3
RATE_SIGNUP_WINDOW="1 hour"
RATE_PUBLISH_MAX=60
RATE_PUBLISH_GUEST_MAX=10
RATE_PUBLISH_WINDOW="1 hour"
RATE_WRITE_MAX=60
RATE_WRITE_WINDOW="1 minute"
RATE_READ_MAX=300
RATE_READ_WINDOW="1 minute"
RATE_UNAUTH_MAX=30
RATE_UNAUTH_WINDOW="1 minute"
