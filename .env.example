# Copy to .env and adjust. Never commit .env.

# Migrations run as the table owner.
DATABASE_URL=postgres://livemap_migrator:livemap_dev@127.0.0.1:5460/livemap

# The application connects as a non-owner role so row-level security actually
# applies to it. A table owner bypasses RLS unless FORCE is set, and relying on
# FORCE alone is one `alter table` away from a silent tenant leak.
APP_DATABASE_URL=postgres://livemap_app:livemap_dev_app@127.0.0.1:5460/livemap

# Cross-tenant platform work only — provisioning a tenant, a support query, a
# backfill. This role has BYPASSRLS, so every policy is inert on it. It is NOT
# the schema owner, which is what separates "may read any tenant" from "may run
# DDL". Never point APP_DATABASE_URL here; serve.mjs asserts that at boot.
ADMIN_DATABASE_URL=postgres://livemap_admin:livemap_dev_admin@127.0.0.1:5460/livemap

POSTGRES_PASSWORD=livemap_dev
APP_DB_PASSWORD=livemap_dev_app
ADMIN_DB_PASSWORD=livemap_dev_admin

# HMAC key for session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me

PORT=8787
LOG_LEVEL=info
