  "description": "Publish pipeline, repository seam and HTTP surface.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/index.js --sourcemap && tsc -p tsconfig.json --emitDeclarationOnly",
