    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.12",
    "@fastify/swagger": "^9.9.5",
    "@livemap/core": "0.1.0",
    "@scalar/fastify-api-reference": "^1.82.1",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  }
}
