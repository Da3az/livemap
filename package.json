{
  "name": "livemap",
  "version": "0.1.0",
  "private": true,
  "description": "Authoring tool for interactive live-event maps",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @livemap/core && npm run build -w @livemap/api && npm run build -w @livemap/web",
    "typecheck": "npm run typecheck -w @livemap/core && npm run typecheck -w @livemap/api && npm run typecheck -w @livemap/web",
    "test": "npm run test --workspaces --if-present",
    "demo": "node --conditions=livemap-source --import tsx demo/server.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "migrate": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate.mjs down",
    "migrate:status": "node scripts/migrate.mjs status",
    "serve": "node --conditions=livemap-source --import tsx scripts/serve.mjs",
    "reap-guests": "node --conditions=livemap-source --import tsx scripts/reap-guests.mjs",
    "mint-token": "node --conditions=livemap-source --import tsx scripts/mint-token.mjs",
    "bench:seed": "node --conditions=livemap-source --import tsx bench/seed.mjs",
    "bench:serve": "node --conditions=livemap-source --import tsx bench/server.mjs",
    "loadtest": "bash loadtest/sweep-all.sh",
    "dev-workspace": "node --conditions=livemap-source --import tsx scripts/dev-workspace.mjs"
  },
  "devDependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright-core": "1.65.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  }
}
